APP_ENV=development
DEMO_MODE=true
SYNTHETIC_DATA_ONLY=true

# Optional for PostgreSQL-backed preview/production-shaped runs.
# The default clean checkout uses the deterministic synthetic repository above.
DATABASE_URL=postgresql://edu_canvas:edu_canvas_dev@127.0.0.1:5432/edu_canvas
# Optional persistence implementation selector. Legacy PostgreSQL remains the default.
# PERSISTENCE_ADAPTER=postgres

# Optional server-only error reporting. Leave unset for structured-log fallback.
# SENTRY_DSN=https://public@example.ingest.sentry.io/project-id

# Required when DEMO_MODE=false. These values are server-only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# OPENAI_BASE_URL=https://api.openai.com/v1
# Per-call provider timeout in milliseconds. Default 100000.
# OPENAI_TIMEOUT_MS=100000

# Authentication (issue #98). Development falls back to a deterministic local
# provider and development-only secrets, so a clean checkout can sign in as the
# synthetic fixture without any of these. Preview and production require them:
# a missing value fails closed at startup.
# AUTH_PROVIDER=supabase
# The exact public origin. Origins are compared byte-for-byte; forwarded
# headers are never trusted.
# AUTH_PUBLIC_ORIGIN=https://app.example.com
# At least 32 characters. Used to bind session forgery tokens to a session.
# AUTH_SESSION_SECRET=
# Base64-encoded 32-byte key for authenticated encryption of provider
# credentials. Losing it invalidates the affected sessions rather than falling
# back to plaintext.
# AUTH_CREDENTIAL_KEY=
# Key version written into new ciphertext. This build loads exactly one key, so
# changing the version invalidates every stored session credential; it is not a
# zero-downtime rotation. The value must not contain a colon.
# AUTH_CREDENTIAL_KEY_VERSION=1
# Supabase Auth (the hosted provider). The service-role key is used only for
# provider-side session revocation and never reaches the browser.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
