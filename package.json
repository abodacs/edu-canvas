{
  "name": "edu-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#/*": "./src/*",
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:database": "RUN_DATABASE_TESTS=true vitest run src/server/persistence/persistence-contract.test.ts src/server/persistence/source-contract.test.ts src/server/persistence/standard-grounding-database.test.ts src/server/persistence/pack-database.test.ts src/server/persistence/records-database.test.ts src/server/persistence/records-restart.test.ts src/server/persistence/progress-database.test.ts src/server/persistence/limits-database.test.ts src/server/persistence/advisory-review-database.test.ts src/server/persistence/tenant-provisioning-database.test.ts src/integration/seed-catalog-roundtrip.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache .",
    "typecheck": "tsrs --noEmit",
    "bench:typecheck": "node scripts/bench-typecheck.mjs",
    "check": "pnpm check:static && pnpm test && pnpm eval:practices --pack delegation --deterministic && pnpm build && pnpm verify:client-boundary && pnpm verify:student-probe",
    "db:migrate": "node --import tsx scripts/database-migrate.ts",
    "db:seed": "node --import tsx scripts/database-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:drizzle:check": "drizzle-kit check --config=drizzle.config.ts",
    "verify:client-boundary": "node --import tsx scripts/verify-client-boundary.ts",
    "verify:architecture": "node --import tsx scripts/verify-architecture.ts",
    "verify:architecture-map": "node --import tsx scripts/verify-architecture-map.ts",
    "verify:glossary-coverage": "node --import tsx scripts/verify-glossary-coverage.ts",
    "verify:identity-surface": "node --import tsx scripts/verify-identity-surface.ts",
    "verify:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "verify:lesson-gate": "vitest run src/server/generation/lesson-gate-properties.test.ts",
    "verify:config": "node --import tsx scripts/verify-config.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fix": "ultracite fix",
    "verify:lc-mcp-eval": "node --import tsx scripts/lc-mcp-eval.ts check",
    "verify:lc-free-text": "node --import tsx scripts/lc-mcp-eval.ts free-text check",
    "lc:rest-matrix": "node --import tsx scripts/lc-rest-matrix.ts",
    "verify:demo-removal": "node --import tsx scripts/verify-demo-removal.ts",
    "typecheck:tsc": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify:student-probe": "node --import tsx scripts/student-probe.ts",
    "verify:catalog-identity": "node --import tsx scripts/verify-catalog-identity.ts",
    "verify:design-tokens": "node --import tsx scripts/verify-design-tokens.ts",
    "verify:design-census": "node --import tsx scripts/verify-design-census.ts",
    "verify:ui": "node --import tsx scripts/verify-ui.ts",
    "census:capture": "node --import tsx scripts/design-census-capture.ts",
    "verify:limits": "node --import tsx scripts/verify-limit-config.ts",
    "verify:ux-ownership": "node --import tsx scripts/verify-ux-ownership.ts",
    "check:static": "pnpm format:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm verify:architecture && pnpm verify:architecture-map && pnpm verify:glossary-coverage && pnpm verify:identity-surface && pnpm verify:demo-removal && pnpm verify:limits && pnpm verify:catalog-identity && pnpm verify:lc-mcp-eval && pnpm verify:lc-free-text && pnpm verify:design-tokens && pnpm verify:ux-ownership && pnpm verify:boundaries",
    "eval:practices": "node --import tsx scripts/eval-practices.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@sentry/node": "10.68.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.25.0",
    "nitro": "3.0.260610-beta",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "unpdf": "2.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.14.0",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "0.31.10",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "oxlint": "^1.91.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "playwright-core": "1.64.1",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.22.1",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "8.0.1",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
