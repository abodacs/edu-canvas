{
  "name": "edu-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#/*": "./src/*",
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:database": "RUN_DATABASE_TESTS=true vitest run src/server/persistence/persistence-contract.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write package.json components.json tsconfig.json tsr.config.json vite.config.ts eslint.config.js prettier.config.js stylelint.config.mjs vitest.config.ts drizzle.config.ts drizzle src scripts migrations README.md docs/foundation-runbook.md docs/release-fly-supabase.md docs/architecture-harness.md docs/agdr/AgDR-0003-nitro-beta-compatibility.md",
    "format:check": "prettier --check package.json components.json tsconfig.json tsr.config.json vite.config.ts eslint.config.js prettier.config.js stylelint.config.mjs vitest.config.ts drizzle.config.ts drizzle src scripts migrations README.md docs/foundation-runbook.md docs/release-fly-supabase.md docs/architecture-harness.md docs/agdr/AgDR-0003-nitro-beta-compatibility.md",
    "typecheck": "tsc --noEmit",
    "typecheck:tsrs": "tsrs --noEmit",
    "bench:typecheck": "node scripts/bench-typecheck.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm typecheck:tsrs && pnpm test && pnpm build && pnpm verify:client-boundary && pnpm verify:architecture",
    "db:migrate": "node --import tsx scripts/database-migrate.ts",
    "db:seed": "node --import tsx scripts/database-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:drizzle:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:drizzle:pull": "drizzle-kit pull --config=drizzle.config.ts",
    "verify:client-boundary": "node --import tsx scripts/verify-client-boundary.ts",
    "verify:architecture": "node --import tsx scripts/verify-architecture.ts",
    "verify:config": "node --import tsx scripts/verify-config.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@sentry/node": "10.68.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "1.25.0",
    "nitro": "3.0.260610-beta",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "0.31.10",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.18",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.13.1",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "8.0.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
